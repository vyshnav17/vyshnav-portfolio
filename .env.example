# MongoDB Atlas Connection URI
# Get this from MongoDB Atlas -> Database -> Connect -> Drivers
# Example: mongodb+srv://<username>:<password>@cluster0.xyz.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=portfolio

# Admin Page Password
# Set this to any secure password you want for accessing /admin
ADMIN_PASSWORD=

# Session Secret (optional, random secret for token signing)
AUTH_SECRET=
